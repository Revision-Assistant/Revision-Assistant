# Client (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional self-hosted LanguageTool (defaults to public api.languagetool.org)
VITE_LANGUAGETOOL_URL=

# Free citation-need model hosting (Hugging Face Hub — public repo, no private papers)
# Example after you upload ONNX: your-username/revision-assistant-citation-need
VITE_CITATION_MODEL_ID=

# --- Netlify Functions only (set in Netlify UI → Environment variables) ---
# Use a NEW free-tier key for the public site. Do NOT paste personal/dev keys into git.
#
# Free LLM options (pick one; recommend Groq free tier for MVP):
#   1) Groq free:      https://console.groq.com  → GROQ_API_KEY
#   2) Google AI free: https://aistudio.google.com/apikey → GEMINI_API_KEY
#   3) OpenRouter free models: https://openrouter.ai → OPENROUTER_API_KEY (optional)
#
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional auth / usage caps
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DAILY_TOKEN_CAP=20000
DAILY_REQUEST_CAP=30
