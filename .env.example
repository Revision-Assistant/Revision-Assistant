# Client (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional self-hosted LanguageTool (defaults to public api.languagetool.org)
VITE_LANGUAGETOOL_URL=

# Free citation-need model hosting (Hugging Face Hub — public repo, no private papers)
# Example after you upload ONNX: your-username/revision-assistant-citation-need
VITE_CITATION_MODEL_ID=sk1729271/revision-assistant-citation-need

# Free manuscript-quality model (numerical / publication / novelty-claim flags)
# Example: your-username/revision-assistant-manuscript-quality
VITE_QUALITY_MODEL_ID=sk1729271/revision-assistant-manuscript-quality

# Trained academic AI-writing detector (advisory; falls back to local heuristics if unset)
# Example after upload: your-username/revision-assistant-ai-detect
VITE_AI_MODEL_ID=sk1729271/revision-assistant-ai-detect

# Optional journal-readiness multi-label heads (Q1-like / Q2-like / IEEE-oriented heuristics)
# Example after upload: your-username/revision-assistant-journal-readiness
# App falls back to pure checklist heuristics if unset or unloadable.
VITE_JOURNAL_MODEL_ID=sk1729271/revision-assistant-journal-readiness

# --- Netlify Functions only (set in Netlify UI → Environment variables) ---
# Use a NEW free-tier key for the public site. Do NOT paste personal/dev keys into git.
# Shared by explain, humanize, grammarFilter (LT keep/drop), journalSuggest.
#
# Free LLM options (pick one; recommend Groq free tier for MVP):
#   1) Groq free:      https://console.groq.com  → GROQ_API_KEY
#   2) Google AI free: https://aistudio.google.com/apikey → GEMINI_API_KEY
#   3) OpenRouter free models: https://openrouter.ai → OPENROUTER_API_KEY (optional)
#
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional auth / usage caps
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DAILY_TOKEN_CAP=20000
DAILY_REQUEST_CAP=30
