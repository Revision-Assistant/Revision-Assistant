import os, sys, time, subprocess
from pathlib import Path
HERE = Path(r"c:\Users\subha\Desktop\plag and AI\training\local")
os.chdir(HERE)
task, epochs = sys.argv[1], sys.argv[2]
status = HERE / f"train_{task}.status"
log = HERE / f"train_{task}.log"
env = os.environ.copy()
env["TF_CPP_MIN_LOG_LEVEL"] = "3"
env["PYTHONUNBUFFERED"] = "1"
# prevent sleep
try:
    import ctypes
    ctypes.windll.kernel32.SetThreadExecutionState(0x80000000|0x00000001)
except Exception:
    pass
t0 = time.time()
with open(log, "w", encoding="utf-8", errors="replace") as f:
    p = subprocess.Popen(
        [sys.executable, "-u", "train_rw_job.py", "--task", task, "--epochs", epochs],
        stdout=f, stderr=subprocess.STDOUT, env=env, cwd=str(HERE),
    )
    status.write_text(f"running pid={p.pid} task={task} epochs={epochs} t0={time.strftime('%H:%M:%S')} script=train_rw_job.py\n", encoding="utf-8")
    rc = p.wait()
status.write_text(f"exit={rc} elapsed_min={(time.time()-t0)/60:.2f} ended={time.strftime('%H:%M:%S')} task={task}\n", encoding="utf-8")
